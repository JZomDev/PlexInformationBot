<?xml version="1.0" encoding="UTF-8"?>
<Configuration name="Plex Info Bot" status="INFO" strict="true">
	<Properties>
		<Property name="LOG_DIR">${env:CONFIG_DIR:-/config}/logs</Property>
	</Properties>

	<Appenders>
		<Console name="Console Appender">
			<PatternLayout>
				<Pattern><![CDATA[%d <%-5p> <%-35.35t> <%x> <%X> <%50.50c> %m%n]]></Pattern>
			</PatternLayout>
			<Filters>
				<ThresholdFilter level="INFO"/>
			</Filters>
		</Console>
		<RollingFile
				name="File Appender"
				fileName="${LOG_DIR}/bot.log"
				filePattern="${LOG_DIR}/bot.%i.log"
				filePermissions="rw-------"
				ignoreExceptions="false">
			<PatternLayout>
				<Pattern><![CDATA[%d{yyyy-MM-dd HH:mm:ss} %-5p %replace{%m}{(?i)((?:token|api_?key)=)[^\s&]+}{$1****}%n]]></Pattern>
			</PatternLayout>
			<Filters>
				<ThresholdFilter level="INFO"/>
			</Filters>
			<Policies>
				<SizeBasedTriggeringPolicy size="2MB"/>
			</Policies>
			<DefaultRolloverStrategy max="3" fileIndex="min"/>
		</RollingFile>
	</Appenders>
	<Loggers>
		<Root level="DEBUG">
			<AppenderRef ref="Console Appender"/>
			<AppenderRef ref="File Appender"/>
		</Root>
	</Loggers>
</Configuration>
